<section class="py-16 text-center space-y-5">
  <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl border border-[var(--frag-border)] bg-[var(--frag-surface)] font-mono text-base font-bold text-[var(--frag-accent)]">
    404
  </div>
  <div class="space-y-1.5">
    <h1 class="text-xl sm:text-2xl font-semibold tracking-tight text-[var(--frag-text)]">
      Fragment Not Found
    </h1>
    <p class="text-sm text-[var(--frag-text-muted)] max-w-md mx-auto">
      This paste does not exist, has been deleted, or has expired.
    </p>
  </div>
  <div>
    <a
      href={~p"/"}
      class="inline-flex items-center gap-2 px-4 py-2 rounded-md text-xs font-medium bg-[var(--frag-accent)] hover:bg-[var(--frag-accent-hover)] text-white transition-colors"
    >
      <.icon name="hero-plus-mini" class="size-4" />
      <span>Create a new fragment</span>
    </a>
  </div>
</section>
